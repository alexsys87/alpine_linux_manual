/*
 * Bitmain Antminer S9 control board (Zynq-7010) - minimal U-Boot device tree.
 *
 * Derived from the MicroZed DTS shipped with U-Boot. Only SD boot, UART and
 * Ethernet are described. The values below are taken from public knowledge
 * about the S9 control board and are NOT verified on real hardware: check
 * the UART, DDR size and Ethernet PHY address against your board revision.
 */
/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "Bitmain Antminer S9 control board";
	compatible = "bitmain,zynq-antminer-s9", "xlnx,zynq-7000";

	aliases {
		serial0 = &uart1;
		mmc0 = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		/* 256 MiB; some board revisions have 512 MiB (0x20000000). */
		reg = <0x0 0x10000000>;
	};

	chosen {
		bootargs = "earlycon";
		stdout-path = "serial0:115200n8";
	};
};

&clkc {
	ps-clk-frequency = <33333333>;
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@0 {
		reg = <0>;
	};
};

&sdhci0 {
	bootph-all;
	status = "okay";
};

&uart1 {
	bootph-all;
	status = "okay";
};
